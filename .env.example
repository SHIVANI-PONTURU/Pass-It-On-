# Copy this file to .env.local and paste your keys after the = signs (no spaces, no quotes).
# Then run: npm run setup   (it checks the keys and fills in the voice IDs and model for you)
# Never commit real keys. .env.local is ignored by Git.
# On Vercel, add the same names under Project Settings > Environment Variables.

# --- Server-only (used by api/ and scripts/; never prefix these with VITE_) ---

# ElevenLabs: pre-made narration (npm run voice) and live answers (/api/speak)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_QUILL=
# One voice per world...
ELEVENLABS_VOICE_MOON=
ELEVENLABS_VOICE_MARS=
# ...or a voice per machine (optional; overrides the world voice):
# ELEVENLABS_VOICE_SURVEYOR_3=
# ELEVENLABS_VOICE_APOLLO_12_ALSEP=
# ELEVENLABS_VOICE_APOLLO_15_LRV=
# ELEVENLABS_VOICE_VIKING_LANDERS=
# ELEVENLABS_VOICE_SOJOURNER=
# ELEVENLABS_VOICE_SPIRIT_OPPORTUNITY=
# Models (defaults shown)
# ELEVENLABS_NARRATION_MODEL=eleven_multilingual_v2
# ELEVENLABS_LIVE_MODEL=eleven_flash_v2_5

# Google Gemini: the painted Moon and Mars backgrounds (npm run art)
GEMINI_API_KEY=

# LLM agent through Amazon Bedrock's OpenAI-compatible Mantle endpoint
MANTLE_API_KEY=
MANTLE_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
MANTLE_MODEL=
# chat (default) or responses, for models that only support the Responses API
# MANTLE_API=chat
# MANTLE_MAX_TOKENS=400
# MANTLE_REASONING_EFFORT=low
# MANTLE_TIMEOUT_MS=7000

# Kill switches and limits (per visitor per minute)
# AGENT_ENABLED=true
# LIVE_VOICE_ENABLED=true
# ASK_PER_MINUTE=20
# SPEAK_PER_MINUTE=30

# --- Browser flags (safe to expose) ---

# true = questions go to /api/ask; false = local, fact-only answers
VITE_USE_AGENT=false
# true = answers not in public/audio are spoken through /api/speak; false = browser voice
VITE_LIVE_VOICE=false
